# Sentinel Environment Configuration Example
# Copy this file to .env and fill in your values. Never commit .env to git.

# Database & Seed
SENTINEL_DB=sentinel.db
SENTINEL_SEED=1337
SENTINEL_DEMO_MODE=1

# Mock LLM Mode: ok | says_safe_always | timeout | garbage | down
SENTINEL_LLM_MODE=ok

# OpenAI Provider Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=3.0

# Runtime Modes: live | simulation (agent), live | rules_only (guard)
SENTINEL_AGENT_MODE=simulation
SENTINEL_GUARD_MODE=live

# Signing Keys (Change for production)
SENTINEL_HUMAN_KEY=demo-human-key-change-me
SENTINEL_APPROVAL_KEY=demo-approval-key-change-me
SENTINEL_EXEC_KEY=demo-exec-key-change-me
SENTINEL_AGENT_PEPPER=demo-pepper-change-me
